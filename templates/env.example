# Store credentials. Copy to .env, which must be git-ignored.
#
# These are account-wide: whoever holds them can edit metadata, prices and agreements for
# every app on the team. They are not app secrets and not build secrets, so they never
# belong in app.json, in EXPO_PUBLIC_ anything, or in a tracked file.

# App Store Connect: Users and Access > Integrations > App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Google Play: a service account JSON from Google Cloud, granted on the Play Console
PLAY_SERVICE_ACCOUNT_KEY_PATH=~/.playconsole/service-account.json
